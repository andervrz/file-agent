# .env.example
# === Ollama Cloud ===
OLLAMA_API_KEY=your_api_key_here
OLLAMA_HOST=https://ollama.com

# === Agent Config ===
AGENT_YAML_PATH=agent.yaml
LOG_LEVEL=INFO

# === Traces ===
TRACES_DIR=./traces

# === Memory (Fase 2) ===
MEMORY_DIR=./memory

# === MCP Servers ===
TAVILY_API_KEY=tvly-tu_api_key_aqui

# ── Chainlit UI ───────────────────────────────────────────────────────────────
# Credenciales para acceder a la interfaz web (usuario único local)
CHAINLIT_USER=ander
CHAINLIT_PASSWORD=fileagent